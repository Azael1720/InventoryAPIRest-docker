@page
@model CreateModel
@{
    ViewData["Title"] = "Nuevo producto";
}

<h1 class="h3 mb-3">Nuevo producto</h1>

@if (Model.Categories.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        No hay categorías disponibles. <a asp-page="/Categories/Create">Crea una categoría</a> antes de registrar productos.
    </div>
}

<div class="row">
    <div class="col-md-7">
        <form method="post" asp-page="Create" data-loading>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Form.Code" class="form-label"></label>
                    <input asp-for="Form.Code" class="form-control" maxlength="50" />
                    <span asp-validation-for="Form.Code" class="text-danger"></span>
                </div>
                <div class="col-md-8 mb-3">
                    <label asp-for="Form.Name" class="form-label"></label>
                    <input asp-for="Form.Name" class="form-control" maxlength="150" />
                    <span asp-validation-for="Form.Name" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Form.Description" class="form-label"></label>
                <textarea asp-for="Form.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Form.Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.Price" class="form-label"></label>
                    <input asp-for="Form.Price" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Form.Price" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.CategoryId" class="form-label"></label>
                    <select asp-for="Form.CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">Selecciona una categoría...</option>
                    </select>
                    <span asp-validation-for="Form.CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Form.Stock" class="form-label"></label>
                <input asp-for="Form.Stock" class="form-control" type="number" min="0" />
                <span asp-validation-for="Form.Stock" class="text-danger"></span>
                <div class="form-text">Se registra como un movimiento inicial de entrada.</div>
            </div>

            <button type="submit" class="btn btn-primary" data-loading-text="Guardando...">Guardar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
