@page
@model IndexModel
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Productos</h1>
    <a class="btn btn-primary" asp-page="Create">Nuevo producto</a>
</div>

@if (Model.LoadError is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@Model.LoadError</span>
        <a class="btn btn-sm btn-outline-danger" asp-page="Index">Reintentar</a>
    </div>
}
else if (Model.Products.Count == 0)
{
    <div class="text-center text-muted border rounded py-5">
        <p class="mb-2">Aún no hay productos registrados.</p>
        <a asp-page="Create">Crear el primero</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th class="text-center">Stock</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr class="@(product.IsActive ? "" : "text-muted")">
                        <td>@product.Code</td>
                        <td>@product.Name</td>
                        <td>@product.CategoryName</td>
                        <td class="text-end">@product.Price.ToString("N2")</td>
                        <td class="text-center">
                            <span class="badge @(product.Stock == 0 ? "bg-danger" : product.Stock <= 5 ? "bg-warning text-dark" : "bg-success")">
                                @product.Stock
                            </span>
                        </td>
                        <td>
                            <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                                @(product.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@product.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Movements/Register" asp-route-productId="@product.Id">Movimiento</a>
                            <a class="btn btn-sm btn-outline-info" asp-page="/Movements/Index" asp-route-productId="@product.Id">Historial</a>
                            @if (product.IsActive)
                            {
                                <form method="post" asp-page="Index" asp-page-handler="Deactivate" asp-route-id="@product.Id" class="d-inline"
                                      onsubmit="return confirm('¿Dar de baja el producto @product.Name?');" data-loading>
                                    <button type="submit" class="btn btn-sm btn-outline-danger" data-loading-text="Procesando...">Dar de baja</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}