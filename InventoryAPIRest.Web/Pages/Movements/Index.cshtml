@page
@model IndexModel
@{
    ViewData["Title"] = "Movimientos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Movimientos de inventario</h1>
    <a class="btn btn-primary" asp-page="Register" asp-route-productId="@Model.ProductId">Registrar movimiento</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3" data-loading>
    <div class="col-md-5">
        <label class="form-label" for="productId">Filtrar por producto</label>
        <select id="productId" name="productId" class="form-select">
            <option value="">Todos los productos</option>
            @foreach (var product in Model.Products)
            {
                <option value="@product.Id" selected="@(Model.ProductId == product.Id)">@product.Code - @product.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary" data-loading-text="Filtrando...">Filtrar</button>
    </div>
    @if (Model.ProductId is not null)
    {
        <div class="col-auto">
            <a asp-page="Index" class="btn btn-link">Quitar filtro</a>
        </div>
    }
</form>

@if (Model.LoadError is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@Model.LoadError</span>
        <a class="btn btn-sm btn-outline-danger" asp-page="Index" asp-route-productId="@Model.ProductId">Reintentar</a>
    </div>
}
else if (Model.Movements.Count == 0)
{
    <div class="text-center text-muted border rounded py-5">
        <p class="mb-2">No hay movimientos registrados.</p>
        <a asp-page="Register" asp-route-productId="@Model.ProductId">Registrar el primero</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Fecha (UTC)</th>
                    <th>Producto</th>
                    <th>Tipo</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-center">Stock</th>
                    <th class="text-end">Precio unitario</th>
                    <th>Motivo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movement in Model.Movements)
                {
                    <tr>
                        <td class="text-nowrap">@movement.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@movement.ProductCode - @movement.ProductName</td>
                        <td><span class="badge @movement.TypeBadgeClass">@movement.TypeLabel</span></td>
                        <td class="text-end">@movement.Quantity</td>
                        <td class="text-center text-nowrap">@movement.StockBefore → @movement.StockAfter</td>
                        <td class="text-end">@(movement.UnitPrice is null ? "—" : movement.UnitPrice.Value.ToString("N2"))</td>
                        <td class="text-muted">@movement.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
