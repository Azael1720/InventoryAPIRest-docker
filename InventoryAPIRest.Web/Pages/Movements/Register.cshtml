@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrar movimiento";
}

<h1 class="h3 mb-3">Registrar movimiento</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" asp-page="Register" data-loading>
            <div class="mb-3">
                <label asp-for="Form.ProductId" class="form-label"></label>
                <select asp-for="Form.ProductId" class="form-select">
                    <option value="">Selecciona un producto...</option>
                    @foreach (var product in Model.Products)
                    {
                        <option value="@product.Id" data-stock="@product.Stock">
                            @product.Code - @product.Name@(product.IsActive ? "" : " (inactivo)")
                        </option>
                    }
                </select>
                <span asp-validation-for="Form.ProductId" class="text-danger"></span>
                <div id="stock-hint" class="form-text"></div>
            </div>

            <div class="mb-3">
                <label asp-for="Form.Type" class="form-label"></label>
                <select asp-for="Form.Type" class="form-select">
                    <option value="">Selecciona el tipo...</option>
                    @foreach (var (value, label) in RegisterModel.MovementTypes)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
                <span asp-validation-for="Form.Type" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Form.Quantity" class="form-label"></label>
                <input asp-for="Form.Quantity" class="form-control" type="number" min="1" />
                <span asp-validation-for="Form.Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Form.Reason" class="form-label"></label>
                <textarea asp-for="Form.Reason" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Form.Reason" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary" data-loading-text="Registrando...">Registrar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const select = document.getElementById('Form_ProductId');
            const hint = document.getElementById('stock-hint');

            function updateHint() {
                const option = select.options[select.selectedIndex];
                const stock = option ? option.dataset.stock : undefined;
                hint.textContent = stock !== undefined ? 'Stock actual: ' + stock : '';
            }

            select.addEventListener('change', updateHint);
            updateHint();
        })();
    </script>
}